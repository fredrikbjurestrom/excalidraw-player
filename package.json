{
  "name": "excalidraw-player",
  "version": "0.1.1",
  "description": "Turn Excalidraw diagrams into animated, configurable presentations.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "examples/*"
  ],
  "files": [
    "dist",
    "docs",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core.js"
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "npm run build:package && npm run build:examples",
    "build:package": "vite build && tsc --project tsconfig.json --emitDeclarationOnly",
    "build:examples": "npm run build --workspace @excalidraw-player/basic-example",
    "test": "npm run build:package && node --test tests/*.test.mjs",
    "dev": "npm run dev --workspace @excalidraw-player/basic-example",
    "dev:basic": "npm run dev --workspace @excalidraw-player/basic-example",
    "pack:player": "npm pack",
    "audit:production": "npm audit --omit=dev",
    "prepare": "npm run build:package"
  },
  "dependencies": {
    "@excalidraw/utils": "0.1.5",
    "lz-string": "1.5.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "excalidraw",
    "presentation",
    "animation",
    "web-component",
    "svg"
  ],
  "publishConfig": {
    "access": "public"
  }
}
